# Copy to .env and fill in values.
# Local: run `supabase start` and paste keys from the CLI output.
# Remote: Project Settings → API in the Supabase dashboard.

# Supabase HTTP API (local default: http://127.0.0.1:54321)
SUPABASE_URL=

# Publishable anon key — used by apps/ui (S9+) with RLS policies
SUPABASE_ANON_KEY=

# Vite exposes these to the browser (copy from above)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key — used by apps/orchestrator and packages/db (bypasses RLS)
# NEVER expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (required once for `pnpm db:setup`)
# Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=

# Or set DB_PASSWORD alone (uses db.[project-ref].supabase.co:5432)
# DB_PASSWORD=

# LLM narration (S13 only — leave blank until then)
# OPENAI_API_KEY=
